@* Views/ImagesEditor/Create.cshtml *@
@model portfolio.ViewModels.ProjectImageFormViewModel
@{ ViewData["Title"] = "Add Project Image"; }

<h3 class="fw-bold mb-3">Add Project Image</h3>
<div class="card shadow-sm p-4" style="max-width: 640px;">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="mb-3">
            <label asp-for="ProjectId" class="form-label"></label>
            <select asp-for="ProjectId" asp-items="Model.Projects" class="form-select">
                <option value="">-- Select Project --</option>
            </select>
            <span asp-validation-for="ProjectId" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ImageUrl" class="form-label"></label>
            <input asp-for="ImageUrl" class="form-control" />
            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Caption" class="form-label"></label>
            <input asp-for="Caption" class="form-control" />
            <span asp-validation-for="Caption" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="SortOrder" class="form-label"></label>
            <input asp-for="SortOrder" class="form-control" />
            <span asp-validation-for="SortOrder" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary">Save Image</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }