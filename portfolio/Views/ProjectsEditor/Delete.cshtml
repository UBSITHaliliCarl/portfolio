@model portfolio.Models.Project
@{ ViewData["Title"] = "Delete Project"; }

<h3 class="fw-bold text-danger mb-3">Delete Project</h3>
<div class="card shadow-sm p-4" style="max-width: 640px;">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <p>Are you sure you want to delete <strong>@Model.ProjectTitle</strong> (and all its attached images)?</p>
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.ProjectId" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>