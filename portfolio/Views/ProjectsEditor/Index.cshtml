@model IEnumerable<portfolio.Models.Project>
@{ ViewData["Title"] = "Manage Projects"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0">Projects (Editor)</h3>
    <a asp-action="Create" class="btn btn-primary">+ Add Project</a>
</div>

<div class="card shadow-sm">
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>Course</th>
                <th>Project Title</th>
                <th>Video</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td><span class="badge bg-secondary">@p.CourseCode</span></td>
                    <td class="fw-semibold">@p.ProjectTitle</td>
                    <td>@(string.IsNullOrWhiteSpace(p.VideoUrl) ? "—" : "YouTube")</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@p.ProjectId" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@p.ProjectId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>