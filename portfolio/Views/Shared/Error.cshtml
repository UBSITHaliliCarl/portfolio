@model ErrorViewModel
@{
    ViewData["Title"] = "Unexpected Error";
}
<div class="text-center py-5">
    <h1 class="display-6 fw-bold text-danger">Something went wrong</h1>
    <p class="text-muted">An unexpected error occurred while processing your request. Please try again.</p>
    <a asp-controller="Portfolio" asp-action="Index" class="btn btn-outline-primary mt-2">Return to Portfolio</a>
</div>