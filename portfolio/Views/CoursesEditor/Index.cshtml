@model IEnumerable<portfolio.Models.Course>
@{ ViewData["Title"] = "Manage Courses"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0">Courses (Editor)</h3>
    <a asp-action="Create" class="btn btn-primary">+ Add Course</a>
</div>

<div class="card shadow-sm">
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>Code</th>
                <th>Title</th>
                <th>Term</th>
                <th>Units</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td class="fw-semibold">@c.CourseCode</td>
                    <td>@c.CourseTitle</td>
                    <td>@c.TermTaken</td>
                    <td>@c.Units</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@c.CourseId" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@c.CourseId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>